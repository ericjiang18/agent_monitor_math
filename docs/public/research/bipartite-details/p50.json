{"n41638":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00035","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00035","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{field}\n  \\lean{QuadraticInteger.field}\n  \\leanok\n  For all rational $r$, we have $r^2 \\neq d$, so $K$ is a field.\n\\end{lemma}","labels_tex":["field"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.field"],"leanok":true,"start_line":91,"stop_line":95},"n41639":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00042","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00042","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Clear since we assume that $d$ is squarefree.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":96,"stop_line":98},"n41640":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00044","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00044","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{d_congr}\n  We have that $d = \\pm 1 \\bmod 4$ or $d = 2 \\bmod 4$.\n  \\lean{QuadraticInteger.d_congr}\n  \\leanok\n\\end{lemma}","labels_tex":["d_congr"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.d_congr"],"leanok":true,"start_line":100,"stop_line":104},"n41641":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00050","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00050","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  If $d = 0 \\bmod 4$ then $d$ would not be squarefree.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":105,"stop_line":107},"n41642":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00061","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00061","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{easy_incl}\n  We have that $\\sqrt{d}$ is an integral element of $K$.\n  \\lean{QuadraticInteger.easy_incl}\n  \\leanok\n\\end{lemma}","labels_tex":["easy_incl"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.easy_incl"],"leanok":true,"start_line":112,"stop_line":116},"n41643":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00067","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00067","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Clear since $\\sqrt{d}$ is a root of $x^2-d$.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":117,"stop_line":119},"n41644":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00078","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00078","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{rational_iff}\n  \\lean{QuadraticInteger.rational_iff}\n  \\leanok\n  We have that $z \\in \\mathbb{Q}$ if and only if $b = 0$.\n\\end{lemma}","labels_tex":["rational_iff"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.rational_iff"],"leanok":true,"start_line":126,"stop_line":130},"n41645":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00084","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00084","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Clear.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":131,"stop_line":133},"n41646":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00085","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00085","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{minpoly}\n  If $b \\neq 0$ then the minimal polynomial of $z$ over $\\mathbb{Q}$ is\n  \\[\n  X^2-2aX+(a^2-db^2)\n  \\]\n  \\lean{QuadraticInteger.minpoly}\n  \\leanok\n\\end{lemma}","labels_tex":["minpoly"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.minpoly"],"leanok":true,"start_line":135,"stop_line":142},"n41647":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00093","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00093","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{rational_iff}\n  It's clear that $z$ is a root of $P$ and that $P \\in \\mathbb{Q}[X]$ is monic.\n  Irreducibility follows by the fact that $P$ has a root that is irrational.\n\\end{proof}","labels_tex":[],"uses":["rational_iff"],"proves":[],"lean_refs":[],"leanok":false,"start_line":143,"stop_line":147},"n41648":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00099","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00099","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{trace}\n  \\lean{QuadraticInteger.trace}\n  \\leanok\n  We have that the trace of $z$ is $2a$.\n\\end{lemma}","labels_tex":["trace"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.trace"],"leanok":true,"start_line":149,"stop_line":153},"n41649":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00105","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00105","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{minpoly, field}\n  If $b = 0$ then $z = a \\in \\mathbb{Q}$ and the trace is $2a$ since $[K : \\mathbb{Q}] = 2$. Otherwise this is clear by Lemma \\ref{minpoly}.\n\\end{proof}","labels_tex":[],"uses":["field","minpoly"],"proves":[],"lean_refs":[],"leanok":false,"start_line":154,"stop_line":157},"n41650":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00112","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00112","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{norm}\n  \\lean{QuadraticInteger.norm}\n  \\leanok\n  We have that the norm of $z$ is $a^2-db^2$.\n\\end{lemma}","labels_tex":["norm"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.norm"],"leanok":true,"start_line":159,"stop_line":163},"n41651":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00118","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00118","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{minpoly, field}\n  If $b = 0$ then $z = a \\in \\mathbb{Q}$ and the norm is $a^2$ since $[K : \\mathbb{Q}] = 2$. Otherwise this is clear by Lemma \\ref{minpoly}.\n\\end{proof}","labels_tex":[],"uses":["field","minpoly"],"proves":[],"lean_refs":[],"leanok":false,"start_line":164,"stop_line":167},"n41652":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00127","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00127","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{trace_int}\n  \\lean{QuadraticInteger.trace_int}\n  \\leanok\n  We have that $2a \\in \\mathbb{Z}$.\n\\end{lemma}","labels_tex":["trace_int"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.trace_int"],"leanok":true,"start_line":172,"stop_line":176},"n41653":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00132","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00132","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{trace}\n  Since the trace of an algebraic integer is an integers, this follows by Lemma \\ref{trace}.\n\\end{proof}","labels_tex":[],"uses":["trace"],"proves":[],"lean_refs":[],"leanok":false,"start_line":177,"stop_line":180},"n41654":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00135","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00135","project":"pitmonticone_QuadraticIntegers","subkind":"definition","is_proof":false,"title":"","content":"\\begin{definition} \\label{t_spec}\n  \\leanok\n  \\lean{QuadraticInteger.t_spec}\n  \\uses{trace_int}\n  We write $t$ (for trace) to denote $2a$ as an integer. Mathematically we have $t = 2a$.\n\\end{definition}","labels_tex":["t_spec"],"uses":["trace_int"],"proves":[],"lean_refs":["QuadraticInteger.t_spec"],"leanok":true,"start_line":182,"stop_line":187},"n41655":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00143","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00143","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{norm_int}\n  \\lean{QuadraticInteger.norm_int}\n  \\leanok\n  We have that $a^2-db^2 \\in \\mathbb{Z}$.\n\\end{lemma}","labels_tex":["norm_int"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.norm_int"],"leanok":true,"start_line":189,"stop_line":193},"n41656":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00148","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00148","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{norm}\n  Since the norm of an algebraic integer is an integers, this follows by Lemma \\ref{norm}.\n\\end{proof}","labels_tex":[],"uses":["norm"],"proves":[],"lean_refs":[],"leanok":false,"start_line":194,"stop_line":197},"n41657":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00151","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00151","project":"pitmonticone_QuadraticIntegers","subkind":"definition","is_proof":false,"title":"","content":"\\begin{definition} \\label{n_spec}\n  \\leanok\n  \\lean{QuadraticInteger.n_spec}\n  \\uses{norm_int}\n  We write $n$ (for norm) to denote $a^2-db^2$ as an integer. Mathematically we have $n = a^2-db^2$.\n\\end{definition}","labels_tex":["n_spec"],"uses":["norm_int"],"proves":[],"lean_refs":["QuadraticInteger.n_spec"],"leanok":true,"start_line":199,"stop_line":204},"n41658":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00159","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00159","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{four_n}\n  We have that $4n = (2a)^2 - d(2b)^2$.\n  \\leanok\n  \\lean{QuadraticInteger.four_n}\n\\end{lemma}","labels_tex":["four_n"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.four_n"],"leanok":true,"start_line":206,"stop_line":210},"n41659":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00164","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00164","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{n_spec}\n  Obvious by applying \\ref{n_spec}.\n\\end{proof}","labels_tex":[],"uses":["n_spec"],"proves":[],"lean_refs":[],"leanok":false,"start_line":211,"stop_line":214},"n41660":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00167","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00167","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{squarefree_mul}\n  \\leanok\n  \\lean{squarefree_mul}\n  Let $n$ be a squarefree integer and let $r$ be a rational such that $b r^2$ is an integer. Then $r$ is\n  itself an integer.\n\\end{lemma}","labels_tex":["squarefree_mul"],"uses":[],"proves":[],"lean_refs":["squarefree_mul"],"leanok":true,"start_line":216,"stop_line":221},"n41661":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00175","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00175","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Easy.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":222,"stop_line":224},"n41662":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00176","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00176","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{two_b_int}\n  \\leanok\n  \\lean{QuadraticInteger.two_b_int}\n  We have that $2b \\in \\mathbb{Z}$.\n\\end{lemma}","labels_tex":["two_b_int"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.two_b_int"],"leanok":true,"start_line":226,"stop_line":230},"n41663":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00181","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00181","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{four_n, trace_int, squarefree_mul}\n  By Lemma \\ref{four_n}, $(2a)^2 - d(2b)^2$ is an integer and so, by Lemma \\ref{trace_int},\n  we know that $d(2b)^2 \\in \\mathbb{Z}$. Since $d$ is squarefree, we conclude that $2b \\in \\mathbb{Z}$ by Lemma \\ref{squarefree_mul}.\n\\end{proof}","labels_tex":[],"uses":["four_n","squarefree_mul","trace_int"],"proves":[],"lean_refs":[],"leanok":false,"start_line":231,"stop_line":235},"n41664":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00190","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00190","project":"pitmonticone_QuadraticIntegers","subkind":"definition","is_proof":false,"title":"","content":"\\begin{definition} \\label{B₂_spec}\n  \\leanok\n  \\lean{QuadraticInteger.B₂_spec}\n  \\uses{two_b_int}\n  We write $B_2$ to denote $2b$ as an integer. Mathematically we have $B_2 = 2b$.\n\\end{definition}","labels_tex":["B₂_spec"],"uses":["two_b_int"],"proves":[],"lean_refs":["QuadraticInteger.B₂_spec"],"leanok":true,"start_line":237,"stop_line":242},"n41665":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00198","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00198","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{b_int_of_a_int}\n  \\leanok\n  \\lean{QuadraticInteger.b_int_of_a_int}\n  If $a \\in \\mathbb{Z}$ then $b \\in \\mathbb{Z}$.\n\\end{lemma}","labels_tex":["b_int_of_a_int"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.b_int_of_a_int"],"leanok":true,"start_line":244,"stop_line":248},"n41666":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00204","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00204","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{four_n, squarefree_mul}\n  By Lemma \\ref{four_n} and our assumption, both $(2a)^2$ and $(2a)^2 - d(2b)^2$ are integers divisible by $4$,\n  so the same holds for $d(2b)^2$. In particular $db^2 \\in \\mathbb{Z}$ and $b \\in \\mathbb{Z}$ by Lemma \\ref{squarefree_mul} since $d$ is squarefree.\n\\end{proof}","labels_tex":[],"uses":["four_n","squarefree_mul"],"proves":[],"lean_refs":[],"leanok":false,"start_line":249,"stop_line":253},"n41667":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00215","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00215","project":"pitmonticone_QuadraticIntegers","subkind":"definition","is_proof":false,"title":"","content":"\\begin{definition} \\label{B_spec}\n  \\leanok\n  \\lean{QuadraticInteger.B_spec}\n  \\uses{b_int_of_a_int}\n  If $a$ is an integer, we write $B$ to denote $b$ as an integer. Mathematically we have $B = b$.\n\\end{definition}","labels_tex":["B_spec"],"uses":["b_int_of_a_int"],"proves":[],"lean_refs":["QuadraticInteger.B_spec"],"leanok":true,"start_line":255,"stop_line":260},"n41668":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00224","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00224","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{a_not_int}\n  \\leanok\n  \\lean{QuadraticInteger.a_not_int}\n  If $a \\not\\in \\mathbb{Z}$ then $d = 1 \\bmod{4}$.\n\\end{lemma}","labels_tex":["a_not_int"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.a_not_int"],"leanok":true,"start_line":262,"stop_line":266},"n41669":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00230","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00230","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{four_n, B₂_spec, t_spec}\n  We have that $2a$, that is an integer, must be odd. By Lemmas \\ref{four_n} and \\ref{two_b_int}, we have\n  $(2a)^2 = d(2b)^2 \\bmod{4}$, so $2b$ must be odd and $d = 1 \\bmod{4}$ as required.\n\\end{proof}","labels_tex":[],"uses":["B₂_spec","four_n","t_spec"],"proves":[],"lean_refs":[],"leanok":false,"start_line":267,"stop_line":271},"n41670":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00239","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00239","project":"pitmonticone_QuadraticIntegers","subkind":"theorem","is_proof":false,"title":"","content":"\\begin{theorem} \\label{d_2_or_3}\n  \\leanok\n  \\lean{QuadraticInteger.d_2_or_3}\n  Assume that $d = 2 \\bmod{4}$ or $d = 3 \\bmod{4}$. Then\n  \\[\n  \\mathcal{O}_K = \\mathbb{Z}[\\sqrt{d}]\n  \\]\n\\end{theorem}","labels_tex":["d_2_or_3"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.d_2_or_3"],"leanok":true,"start_line":275,"stop_line":282},"n41671":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00246","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00246","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{easy_incl, a_not_int, d_congr, B_spec, b_int_of_a_int}\n  By Lemma \\ref{easy_incl} we know that $\\mathbb{Z}[\\sqrt{d}] \\subseteq \\mathcal{O}_K$. Let $z = a + b \\sqrt{d} \\in \\mathcal{O}_K$, with\n  $a, b \\in \\mathbb{Q}$. By Lemma \\ref{a_not_int} we have that $a \\in \\mathbb{Z}$ (since by Lemma \\ref{d_congr} we cannot have\n  $d = 1 \\bmod{4}$), and so by Lemma \\ref{b_int_of_a_int} we have $b \\in \\mathbb{Z}$, so $z \\in \\mathbb{Z}[\\sqrt{d}]$.\n\\end{proof}","labels_tex":[],"uses":["B_spec","a_not_int","b_int_of_a_int","d_congr","easy_incl"],"proves":[],"lean_refs":[],"leanok":false,"start_line":283,"stop_line":288},"n41672":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00262","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00262","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{e_spec}\n  \\leanok\n  \\lean{QuadraticInteger.e_spec}\n  We have that $e$ is an integer and $4e = d - 1$.\n\\end{lemma}","labels_tex":["e_spec"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.e_spec"],"leanok":true,"start_line":293,"stop_line":297},"n41673":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00268","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00268","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Obvious.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":298,"stop_line":300},"n41674":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00274","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00274","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{algebra_R_S}\n  \\leanok\n  \\lean{QuadraticInteger.algebra_R_S}\n  We have that\n  \\[\n  \\left(2 \\left( \\frac{1+\\sqrt{d}}{2} \\right) - 1 \\right)^2 = d\n  \\]\n  so that $S$ is an $R$-algebra.\n\\end{lemma}","labels_tex":["algebra_R_S"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.algebra_R_S"],"leanok":true,"start_line":304,"stop_line":312},"n41675":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00281","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00281","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{e_spec}\n  Obvious by Lemma \\ref{e_spec}.\n\\end{proof}","labels_tex":[],"uses":["e_spec"],"proves":[],"lean_refs":[],"leanok":false,"start_line":313,"stop_line":316},"n41676":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00284","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00284","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{algebra_S_K}\n  \\leanok\n  \\lean{QuadraticInteger.algebra_S_K}\n  We have that\n  \\[\n  \\left( \\frac{1+\\sqrt{d}}{2} \\right)^2 = \\left( \\frac{1+\\sqrt{d}}{2} \\right) + e\n  \\]\n  so that $K$ is an $S$-algebra.\n\\end{lemma}","labels_tex":["algebra_S_K"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.algebra_S_K"],"leanok":true,"start_line":318,"stop_line":326},"n41677":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00291","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00291","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{e_spec}\n  Obvious by Lemma \\ref{e_spec}.\n\\end{proof}","labels_tex":[],"uses":["e_spec"],"proves":[],"lean_refs":[],"leanok":false,"start_line":327,"stop_line":330},"n41678":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00294","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00294","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{commutes_R_S_K}\n  \\leanok\n  \\lean{QuadraticInteger.commutes_R_S_K}\n  The obvious diagram between $R$, $S$ and $K$ commutes.\n\\end{lemma}","labels_tex":["commutes_R_S_K"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.commutes_R_S_K"],"leanok":true,"start_line":332,"stop_line":336},"n41679":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00301","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00301","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{algebra_R_S, algebra_S_K}\n  Clear.\n\\end{proof}","labels_tex":[],"uses":["algebra_R_S","algebra_S_K"],"proves":[],"lean_refs":[],"leanok":false,"start_line":337,"stop_line":340},"n41680":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00303","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00303","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{easy_incl_d_1}\n  \\leanok\n  \\lean{QuadraticInteger.easy_incl_d_1}\n  We have that $\\frac{1+\\sqrt{d}}{2} \\in \\mathcal{O}_K$.\n\\end{lemma}","labels_tex":["easy_incl_d_1"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.easy_incl_d_1"],"leanok":true,"start_line":342,"stop_line":346},"n41681":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00308","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00308","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{e_spec, algebra_S_K}\n  Clear since $\\frac{1+\\sqrt{d}}{2}$ is a root of $X^2 - X - e \\in \\mathbb{Z}[X]$.\n\\end{proof}","labels_tex":[],"uses":["algebra_S_K","e_spec"],"proves":[],"lean_refs":[],"leanok":false,"start_line":347,"stop_line":350},"n41682":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00312","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00312","project":"pitmonticone_QuadraticIntegers","subkind":"lemma","is_proof":false,"title":"","content":"\\begin{lemma} \\label{d_1_int}\n  \\leanok\n  \\lean{QuadraticInteger.d_1_int}\n  Take $z = a + b \\sqrt{d} \\in \\mathcal{O}_K$ with $a, b \\in \\mathbb{Q}$.\n  If $a \\in \\mathbb{Z}$ then $z \\in \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]$.\n\\end{lemma}","labels_tex":["d_1_int"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.d_1_int"],"leanok":true,"start_line":352,"stop_line":357},"n41683":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00320","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00320","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{b_int_of_a_int}\n  By Lemma \\ref{b_int_of_a_int} we have that $b \\in \\mathbb{Z}$ and so $z \\in \\mathbb{Z}[\\sqrt{d}] \\subseteq \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]$.\n\\end{proof}","labels_tex":[],"uses":["b_int_of_a_int"],"proves":[],"lean_refs":[],"leanok":false,"start_line":358,"stop_line":361},"n41684":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00325","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00325","project":"pitmonticone_QuadraticIntegers","subkind":"theorem","is_proof":false,"title":"","content":"\\begin{theorem} \\label{d_1}\n  \\leanok\n  \\lean{QuadraticInteger.d_1}\n  We have\n  \\[\n  \\mathcal{O}_K = \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]\n  \\]\n\\end{theorem}","labels_tex":["d_1"],"uses":[],"proves":[],"lean_refs":["QuadraticInteger.d_1"],"leanok":true,"start_line":363,"stop_line":370},"n41685":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00330","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00330","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  \\uses{easy_incl_d_1, d_1_int, t_spec}\n  By Lemma \\ref{easy_incl_d_1} we know that $\\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right] \\subseteq \\mathcal{O}_K$.\n  Let $z = a + b \\sqrt{d} \\in \\mathcal{O}_K$, with $a, b \\in \\mathbb{Q}$.\n  \\begin{itemize}\n    \\item If $ a \\in \\mathbb{Z}$ we conclude by Lemma \\ref{d_1_int}.\n    \\item If $a \\notin \\mathbb{Z}$, let us consider\n  \\[\n  z' = z - \\frac{1+\\sqrt{d}}{2} = a - \\frac{1}{2} + \\left( b - \\frac{1}{2} \\right) \\sqrt{d} \\in \\mathcal{O}_K\n  \\]\n  Since $2a \\in \\mathbb{Z}$ and $a \\notin \\mathbb{Z}$, we have that $a - \\frac{1}{2} \\in \\mathbb{Z}$, so by Lemma \\ref{d_1_int},\n  we have that $z' \\in \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]$ and so $z \\in \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]$.\n  \\end{itemize}\n\\end{proof}","labels_tex":[],"uses":["d_1_int","easy_incl_d_1","t_spec"],"proves":[],"lean_refs":[],"leanok":false,"start_line":371,"stop_line":384},"n41686":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00357","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00357","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_d_congr}\n  We have that $d = \\pm 1 \\bmod 4$ or $d = 2 \\bmod 4$.\n\\end{human_lemma}","labels_tex":["human_d_congr"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":394,"stop_line":396},"n41687":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00361","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00361","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  If $d = 0 \\bmod 4$ then $d$ would not be squarefree.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":397,"stop_line":399},"n41688":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00364","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00364","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_easy_incl}\n  We have that $\\sqrt{d} \\in \\mathcal{O}_K$.\n\\end{human_lemma}","labels_tex":["human_easy_incl"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":401,"stop_line":403},"n41689":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00367","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00367","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Clear since $\\sqrt{d}$ is a root of $x^2-d$.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":404,"stop_line":406},"n41690":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00370","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00370","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_easy_incl_d_1}\n  If $d = 1 \\bmod{4}$ then $\\frac{1+\\sqrt{d}}{2} \\in \\mathcal{O}_K$.\n\\end{human_lemma}","labels_tex":["human_easy_incl_d_1"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":408,"stop_line":410},"n41691":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00374","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00374","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Write $d = 4a + 1$, with $a \\in \\mathbb{Z}$. Then $\\frac{1+\\sqrt{d}}{2}$ is a root of $x^2 - x - a \\in \\mathbb{Z}[x]$.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":411,"stop_line":413},"n41692":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00384","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00384","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_minpoly}\n  The minimal polynomial of $t$ over $\\mathbb{Q}$ is\n  \\[\n  P(x) = x^2-2at+(a^2-db^2)\n  \\]\n\\end{human_lemma}","labels_tex":["human_minpoly"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":418,"stop_line":423},"n41693":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00389","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00389","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  It's clear that $t$ is a root of $P$ and that $P \\in \\mathbb{Q}[x]$ is monic.\n\n  Irreducibility follows by the fact that $P$ has a root that is not rational.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":424,"stop_line":428},"n41694":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00394","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00394","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_trace}\n  We have that the trace of $t$ is $2a$.\n\\end{human_lemma}","labels_tex":["human_trace"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":430,"stop_line":432},"n41695":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00398","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00398","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Clear by Lemma \\ref{human_minpoly}.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":433,"stop_line":435},"n41696":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00400","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00400","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_norm}\n  We have that the norm of $t$ is $a^2-db^2$.\n\\end{human_lemma}","labels_tex":["human_norm"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":437,"stop_line":439},"n41697":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00404","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00404","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Clear by Lemma \\ref{human_minpoly}.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":440,"stop_line":442},"n41698":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00407","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00407","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_trace_int}\n  We have that $2a \\in \\mathbb{Z}$\n\\end{human_lemma}","labels_tex":["human_trace_int"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":446,"stop_line":448},"n41699":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00410","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00410","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Since the trace of an algebraic integer is an integers, this follows by Lemma \\ref{human_trace}.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":449,"stop_line":451},"n41700":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00412","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00412","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_norm_int}\n  We have that $a^2-db^2 \\in \\mathbb{Z}$\n\\end{human_lemma}","labels_tex":["human_norm_int"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":453,"stop_line":455},"n41701":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00415","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00415","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Since the norm of an algebraic integer is an integers, this follows by Lemma \\ref{human_norm}.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":456,"stop_line":458},"n41702":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00417","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00417","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_divisible}\nWe have that $(2a)^2 - d(2b)^2$ is an integer divisible by $4$.\n\\end{human_lemma}","labels_tex":["human_divisible"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":460,"stop_line":462},"n41703":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00421","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00421","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  Clear since $(2a)^2 - d(2b)^2 = 4(a^2-db^2)$ and $a^2-db^2 \\in \\mathbb{Z}$ by Lemma \\ref{human_norm_int}.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":463,"stop_line":465},"n41704":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00425","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00425","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_2b_int}\n  We have that $2b \\in \\mathbb{Z}$.\n\\end{human_lemma}","labels_tex":["human_2b_int"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":467,"stop_line":469},"n41705":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00428","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00428","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  By Lemma \\ref{human_divisible}, $(2a)^2 - d(2b)^2$ is an integer and so, by Lemma \\ref{human_trace_int},\n  we know that $d(2b)^2 \\in \\mathbb{Z}$. Since $d$ is squarefree, we conclude that $2b \\in \\mathbb{Z}$.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":470,"stop_line":473},"n41706":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00435","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00435","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_b_int_of_a_int}\n  If $a \\in \\mathbb{Z}$ then $b \\in \\mathbb{Z}$.\n\\end{human_lemma}","labels_tex":["human_b_int_of_a_int"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":475,"stop_line":477},"n41707":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00439","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00439","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  By Lemma \\ref{human_divisible} and our assumption, both $(2a)^2$ and $(2a)^2 - d(2b)^2$ are integers divisible by $4$,\n  so the same holds for $d(2b)^2$. In particular $db^2 \\in \\mathbb{Z}$ and $b \\in \\mathbb{Z}$ since $d$ is squarefree.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":478,"stop_line":481},"n41708":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00448","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00448","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_a_not_int}\n  If $a \\not\\in \\mathbb{Z}$ then $d = 1 \\bmod{4}$.\n\\end{human_lemma}","labels_tex":["human_a_not_int"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":483,"stop_line":485},"n41709":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00452","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00452","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  We have that $2a$, that is an integer, must be odd. By Lemmas \\ref{human_divisible} and \\ref{human_2b_int}, we have\n  $(2a)^2 = d(2b)^2 \\bmod{4}$, so $2b$ must be odd and $d = 1 \\bmod{4}$ as required.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":486,"stop_line":489},"n41710":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00464","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00464","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  By Lemma \\ref{human_easy_incl} we know that $\\mathbb{Z}[\\sqrt{d}] \\subseteq \\mathcal{O}_K$. Let $t = a + b \\sqrt{d} \\in \\mathcal{O}_K$, with\n  $a, b \\in \\mathbb{Q}$. By Lemma \\ref{human_a_not_int} we have that $a \\in \\mathbb{Z}$ (since by Lemma \\ref{human_d_congr} we cannot have\n  $d = 1 \\bmod{4}$), and so by Lemma \\ref{human_b_int_of_a_int} we have $b \\in \\mathbb{Z}$, so $t \\in \\mathbb{Z}[\\sqrt{d}]$.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":497,"stop_line":501},"n41711":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00476","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00476","project":"pitmonticone_QuadraticIntegers","subkind":"human_lemma","is_proof":false,"title":"","content":"\\begin{human_lemma} \\label{human_d_1_int}\n  Assume that $d = 1 \\bmod{4}$ and take $t = a + b \\sqrt{d} \\in \\mathcal{O}_K$ with $a, b \\in \\mathbb{Q}$.\n  If $a \\in \\mathbb{Z}$ then $t \\in \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]$.\n\\end{human_lemma}","labels_tex":["human_d_1_int"],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":503,"stop_line":506},"n41712":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00483","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00483","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  By Lemma \\ref{human_b_int_of_a_int} we have that $b \\in \\mathbb{Z}$ and so $t \\in \\mathbb{Z}[\\sqrt{d}] \\subseteq \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]$.\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":507,"stop_line":509},"n41713":{"source_id":"pitmonticone_QuadraticIntegers::1ba722069dda:E00491","uid":"pitmonticone_QuadraticIntegers::1ba722069dda:E00491","project":"pitmonticone_QuadraticIntegers","subkind":"proof","is_proof":true,"title":"","content":"\\begin{proof}\n  By Lemma \\ref{human_easy_incl_d_1} we know that $\\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right] \\subseteq \\mathcal{O}_K$.\n  Let $t = a + b \\sqrt{d} \\in \\mathcal{O}_K$, with $a, b \\in \\mathbb{Q}$.\n  \\begin{itemize}\n    \\item If $ a \\in \\mathbb{Z}$ we conclude by Lemma \\ref{human_d_1_int}.\n    \\item If $a \\notin \\mathbb{Z}$, let us consider\n  \\[\n  t' = t - \\frac{1+\\sqrt{d}}{2} = a - \\frac{1}{2} + \\left( b - \\frac{1}{2} \\right) \\sqrt{d} \\in \\mathcal{O}_K\n  \\]\n  Since $2a \\in \\mathbb{Z}$ and $a \\notin \\mathbb{Z}$, we have that $a - \\frac{1}{2} \\in \\mathbb{Z}$, so by Lemma \\ref{human_d_1_int},\n  we have that $t' \\in \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]$ and so $t \\in \\mathbb{Z}\\left[ \\frac{1+\\sqrt{d}}{2} \\right]$.\n  \\end{itemize}\n\\end{proof}","labels_tex":[],"uses":[],"proves":[],"lean_refs":[],"leanok":false,"start_line":517,"stop_line":529}}
