# ── LLM providers (LiteLLM-compatible env vars) ─────────────────────────────
# For local development, copy this template to `.env` and edit that copy.
# Hosted server settings are managed separately; do not put secrets here.

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Kimi K3 — OpenAI-compatible Chat Completions
KIMI_API_KEY=
# KIMI_API_BASE=https://2qg3r7w8aefiukbds.flashflame.ai/v1
# KIMI_REASONING_EFFORT=max

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHERAI_API_KEY=
XAI_API_KEY=

# ── Defaults ────────────────────────────────────────────────────────────────
AGENT_MONITOR_MODEL=gpt-5.6-sol
# HERMES_MODEL=
# AGENT_MONITOR_BASE_URL=
# AGENT_MONITOR_MAX_ITERATIONS=40
# Default wall-clock limit for CLI engines; individual engines may override it.
# AGENT_MONITOR_CLI_TIMEOUT=3600
# Full file-backed DeepAgents audits default to three hours unless overridden.
# AGENT_MONITOR_DEEPAGENTS_TIMEOUT=10800

# ── Service ───────────────────────────────────────────────────────────────
# AGENT_MONITOR_PORT=4600
# Bind to loopback when a reverse proxy terminates public HTTP/HTTPS.
# AGENT_MONITOR_HOST=127.0.0.1
# Optional URL prefix, e.g. https://example.com/private-console/.
# AGENT_MONITOR_BASE_PATH=/private-console
# Optional prewarmed Mathlib project used by Lean Verification.
# AGENT_MONITOR_MATHLIB_PROJECT=/home/ubuntu/.cache/agent-monitor/mathlib-v4.14.0
# Offer a restricted, cookie-scoped "Continue as guest" path (enabled by default).
# AGENT_MONITOR_GUEST_ACCESS=0
# Guests default to the tool-free Kimi K3 draft/critique/refine harness.
# The eligible engines are `kimi` and `plain`; Claude Code and Codex require sign-in.
# AGENT_MONITOR_GUEST_ENGINES=kimi,plain
# Optional dedicated key for hosted guest Kimi runs; otherwise KIMI_API_KEY is used.
# Without either hosted key, guests can add their own Kimi key in Settings.
# AGENT_MONITOR_GUEST_KIMI_API_KEY=
# AGENT_MONITOR_GUEST_MAX_ITERATIONS=8
# AGENT_MONITOR_GUEST_MAX_OUTPUT_TOKENS=4096
# AGENT_MONITOR_GUEST_CONCURRENCY=1
# AGENT_MONITOR_GUEST_GLOBAL_CONCURRENCY=2
# Total guest run starts, capped at 10. Deleting runs does not restore the allowance.
# After the allowance is used, the visitor must sign in to start more runs.
# AGENT_MONITOR_GUEST_RUNS_PER_SESSION=10
# AGENT_MONITOR_GUEST_RUNS_PER_HOUR=6
# AGENT_MONITOR_GUEST_GLOBAL_RUNS_PER_HOUR=30
# AGENT_MONITOR_GUEST_VERIFICATIONS_PER_HOUR=6
# AGENT_MONITOR_GUEST_GLOBAL_VERIFICATIONS_PER_HOUR=60
# AGENT_MONITOR_GUEST_VERIFY_GLOBAL_CONCURRENCY=4
# Manual guest Formal/Lean and DAG actions; automatic views run once per proof.
# AGENT_MONITOR_GUEST_DERIVED_ACTIONS_PER_HOUR=24
# AGENT_MONITOR_GUEST_DERIVED_GLOBAL_ACTIONS_PER_HOUR=120
# AGENT_MONITOR_GUEST_DERIVED_GLOBAL_CONCURRENCY=2
# AGENT_MONITOR_GUEST_SESSIONS_PER_MINUTE=10
# PLAIN_CMD or KIMI_PROOF_CMD disables that engine for guests because command
# overrides are outside the built-in tool-free execution contract.
# Self-registration is closed unless an operator explicitly opens it. Enable
# only for a controlled enrollment window; local harnesses are not a sandbox.
# AGENT_MONITOR_REGISTRATION_OPEN=1
# Open to anyone: skip the choice screen and issue a guest session per visitor.
# AGENT_MONITOR_PUBLIC=1

# ── Sign in with Google (optional) ──────────────────────────────────────────
# OAuth "Web application" client ID from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin must include your site (e.g. https://moonshot.hailab.io)
# GOOGLE_OAUTH_CLIENT_ID=

# ── Engine paths (optional) ─────────────────────────────────────────────────
# UCLA_HARNESS_ROOT=
# IMPROOF_ROOT=
# CODEX_CMD=
# OPENCLAUDE_CMD=
# OPENHANDS_CMD=
